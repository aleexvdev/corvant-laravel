DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=corvant_testing
DB_USERNAME=corvant
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379

CORVANT_PASSWORD_MIN_LENGTH=8
CORVANT_PASSWORD_REQUIRE_MIXED_CASE=true
CORVANT_PASSWORD_REQUIRE_NUMBERS=true
CORVANT_PASSWORD_REQUIRE_SYMBOLS=true
CORVANT_LOGIN_ATTEMPTS_PER_MINUTE=5
CORVANT_ACCOUNT_LOCKOUT_MAX_FAILED_ATTEMPTS=5
CORVANT_ACCOUNT_LOCKOUT_DURATION_SECONDS=900
CORVANT_SESSION_TTL_SECONDS=3600
CORVANT_TENANT_HEADER=X-Tenant-ID
CORVANT_PASSWORD_RESET_TTL_SECONDS=3600
CORVANT_EMAIL_VERIFICATION_TTL_SECONDS=86400
CORVANT_EMAIL_CHANGE_TTL_SECONDS=86400
CORVANT_MFA_CHALLENGE_TTL_SECONDS=300
CORVANT_MFA_RECOVERY_CODES_COUNT=10
CORVANT_MFA_ISSUER=Corvant
